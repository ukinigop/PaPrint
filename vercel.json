{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix mobile",
  "buildCommand": "npm run build",
  "outputDirectory": "mobile/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/src/pdf-preview-client.js,node_modules/pdfjs-dist/{legacy/build,cmaps,standard_fonts}/**,mobile/node_modules/@expo-google-fonts/manrope/{500Medium,700Bold}/*.ttf}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
